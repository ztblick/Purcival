# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Default Provider ---
# Which LLM family to use: "claude", "chatgpt", or "ollama"
# This is the only setting you need to change to switch providers.
# Per-task models (chat, summary, reasoning) have sensible defaults —
# override them with CLAUDE_CHAT_MODEL, CHATGPT_REASONING_MODEL, etc. if needed.
DEFAULT_PROVIDER=ollama

# --- Claude (Anthropic API) ---
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-key-here

# --- ChatGPT (OpenAI API) ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-key-here

# --- Ollama (local inference) ---
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull models: ollama pull phi4
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi4
OLLAMA_SUMMARY_MODEL=phi4
OLLAMA_REASONING_MODEL=phi4

# --- Personas ---
# Default persona when using -m (single message mode)
DEFAULT_PERSONA=jo

# --- Dashboard auth / exposure ---
# Generate the password hash with:
#   .\venv\Scripts\python.exe scripts\hash_dashboard_password.py
PURCIVAL_DASHBOARD_PASSWORD_HASH=
PURCIVAL_DASHBOARD_SECRET_KEY=
PURCIVAL_DASHBOARD_EXPOSURE=local
PURCIVAL_DASHBOARD_HOST=127.0.0.1
PURCIVAL_DASHBOARD_PORT=8000
# Required for tailscale exposure mode; keep blank for local mode.
PURCIVAL_DASHBOARD_PUBLIC_BASE_URL=
PURCIVAL_DASHBOARD_SESSION_DAYS=30
PURCIVAL_DASHBOARD_PERSONA=jo
PURCIVAL_DASHBOARD_PROVIDER=

# --- Telegram (implemented, currently inactive) ---
# Telegram is not currently operable in Zach's Windows setup. Keep these empty
# unless you are explicitly reactivating Telegram support.
# Your Telegram user ID (message @userinfobot to find it)
TELEGRAM_ALLOWED_USER_ID=

# Your Telegram chat ID for proactive messaging.
# To find it: message the bot, then check the logs for "Chat ID captured"
# or run: python -c "from memory import PersonaMemory; m = PersonaMemory('jo'); print(m.get_tool_state('telegram', 'chat_id'))"
# This is the same for all personas — it's your chat with each bot.
TELEGRAM_CHAT_ID=

# Bot tokens — one per persona (get from @BotFather)
# The variable name must be TELEGRAM_TOKEN_<PERSONA_NAME_UPPERCASE>
TELEGRAM_TOKEN_PURCIVAL=
TELEGRAM_TOKEN_JO=
TELEGRAM_TOKEN_ADA=
TELEGRAM_TOKEN_DEFAULT=
